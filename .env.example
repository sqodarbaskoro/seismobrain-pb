# SeismoBrain environment template. Copy to .env (or run `npm run setup`, which generates
# random secrets for you). Placeholders only; never commit a real .env.
# Full descriptions: README.md "Configuration". Source of truth: apps/api/src/seismobrain_api/config.py

# --- Required -----------------------------------------------------------------------
# Required. Generate each with: openssl rand -hex 32  (or run `npm run setup`)
JWT_SECRET=
# MASTER_KEY also encrypts LLM provider keys stored in the catalog.
MASTER_KEY=

# --- Core ---------------------------------------------------------------------------
# starter | team | production
SB_TIER=starter
# development | production | test
ENVIRONMENT=development
# approval | closed | open
REGISTRATION_MODE=approval
BIND_HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8080
# SQLite, search index, objects, queue lock (Starter)
SB_DATA_DIR=data
AIR_GAPPED=false

# --- Tokens, limits, uploads (defaults shown) ----------------------------------------
# 1..15
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_MIN=30
UPLOAD_RATE_LIMIT_PER_HOUR=60
# 200 MiB
UPLOAD_MAX_BYTES=209715200

# --- Model service (apps/models) ------------------------------------------------------
# SB_MODELS_DEVICE=cpu
# SB_MODELS_ALLOW_GPU=false
# SB_MODELS_EMBED_DIM=32

# --- Team / Production ----------------------------------------------------------------
# Alembic / db:migrate
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/seismobrain
# deploy/compose.yaml
# API_WORKERS=2
# INGEST_PROCESSES=2
# SCAN_ROOT=./scan
# deploy/proxy/Caddyfile
# SB_DOMAIN=localhost
# ACME_EMAIL=you@example.com
# TLS_MODE=
# The Postgres password is a Docker secret file: deploy/secrets/pg_password (not an env var).

# --- Tools / tests --------------------------------------------------------------------
# scripts/doctor.mjs
# SB_PORT=8080
# apps/web/vite.config.ts
# VITE_API_PROXY=
# Playwright
# E2E_API_PORT=18080
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=change-me-e2e-only
